<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- A DeX file browser needs access to user-chosen project directories,
         including source trees that are not media files. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- The same access on Android 7–10 (minSdk 24), where All files access
         doesn't exist yet: the legacy pair, requested at runtime, retired by
         the system from API 30 on. Without them those devices install fine and
         then list nothing, with no prompt and no explanation. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Required before Android will let this app hand an APK to its package installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- A book has to keep playing with the screen off, and Android's answer
         to "this app is doing something the user can hear" is a foreground
         service of type mediaPlayback. Without the service the webview is a
         background app and gets reaped mid-chapter; without the type, API 34
         refuses to start the service at all. POST_NOTIFICATIONS is asked for
         at the moment the first book plays — the notification *is* the
         transport control, so a refusal costs the lock screen buttons. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- No WAKE_LOCK: a foreground service playing audio already keeps the CPU
         awake through the audio path, and asking for a permission we don't use
         is a line on the install screen that buys nothing. -->

    <!-- The tick at the moment a long press lands. It is what makes the press
         feel like something the app did rather than something it noticed, and
         it is the only feedback available while the finger is still covering
         the thing it just selected. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.fiddler"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- "Open with Fiddler", from another app's file list or share sheet.
                 The types below are exactly the ones Quick Look can draw — see
                 `src/preview/route.ts`. Claiming more would put Fiddler in
                 choosers it has nothing to show for, which is the same mistake
                 as a file browser inventing a git status.

                 `application/octet-stream` is the awkward one, and it is here on
                 purpose: Android's MimeTypeMap has no entry for `.md`, `.rs`,
                 `.toml` or most of `CODE`, so Downloads and Drive hand those
                 over as octet-stream and there is no other way to be offered
                 them. It does mean Fiddler appears for some binaries it can
                 only describe rather than draw. -->
            <intent-filter android:label="@string/open_with_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- The share sheet, which is how a file arrives from an app that
                 has no file list of its own — a mail attachment, a photo, a
                 chat download. -->
            <intent-filter android:label="@string/open_with_label">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- The service that keeps a book alive and puts it on the lock
             screen. Not exported: everything that reaches it comes from this
             app's own PendingIntents. Headphone and Bluetooth buttons need no
             receiver here — since Lollipop they go to whichever MediaSession
             was last active, which is the one this service holds. -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
