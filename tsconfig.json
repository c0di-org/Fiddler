{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* Tests run under Node's own runner (`npm test`), which strips the types
     rather than checking them, and they use `node:*` modules this project has
     no typings for. Keeping them out of the app's typecheck is what lets the
     parser have tests without the project gaining a test framework. */
  "exclude": ["src/**/*.test.ts"]
}
