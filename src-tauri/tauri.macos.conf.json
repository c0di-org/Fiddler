{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Fiddler",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState",
          "radius": 12
        }
      }
    ],
    "macOSPrivateApi": true
  },
  "bundle": {
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
