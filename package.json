{
  "name": "fiddler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:web": "vite --mode web",
    "build:web": "tsc && vite build --mode web",
    "preview:web": "vite preview --mode web --outDir dist-web",
    "deploy": "npm run build:web && wrangler deploy",
    "tauri": "tauri",
    "test": "node --test --experimental-strip-types src/*.test.ts src/audio/*.test.ts src/edit/*.test.ts src/preview/*.test.ts src/backend/*.test.ts src/backend/web/*.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "wrangler": "^4.120.0"
  }
}
