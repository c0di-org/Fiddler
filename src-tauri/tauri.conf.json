{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fiddler",
  "version": "0.5.2",
  "identifier": "app.fiddler.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fiddler",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 420,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**",
          "/storage/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/Fiddler.desktop",
        "files": {
          "/usr/share/metainfo/app.fiddler.desktop.metainfo.xml": "linux/app.fiddler.desktop.metainfo.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/app.fiddler.desktop.metainfo.xml": "linux/app.fiddler.desktop.metainfo.xml"
        }
      }
    }
  }
}
